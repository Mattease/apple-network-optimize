#!name=苹果解除电子围栏
#!desc=解除苹果服务地区限制，支持 iCloud Private Relay、Apple Relay 等相关域名的代理转发。可自定义策略组和规则类型。
#!category=Apple
#!compatible=shadowrocket
#!author=CIRE
#!icon=https://avatars.githubusercontent.com/Mattease
#!homepage=https://github.com/Mattease
#!date=2026-08-10
#!version=1.0.1

#!arguments=代理策略:PROXY
#!arguments-desc=代理策略: 填写你要使用的策略组名称，例如 PROXY、🍎 苹果解锁、🇺🇸 美国节点 等。

[Rule]
# ===== Apple Geofence Unlock Domains =====

# Siri & Guzzoni
DOMAIN-SUFFIX,guzzoni.apple.com,{{{代理策略}}}

# iCloud Private Relay / Mask
DOMAIN-SUFFIX,mask-api.fe.apple-dns.net,{{{代理策略}}}
DOMAIN-SUFFIX,mask-api.icloud.com,{{{代理策略}}}
DOMAIN-SUFFIX,mask-t.apple-dns.net,{{{代理策略}}}
DOMAIN-SUFFIX,mask.apple-dns.net,{{{代理策略}}}
DOMAIN-SUFFIX,mask-h2.icloud.com,{{{代理策略}}}
DOMAIN-SUFFIX,mask.icloud.com,{{{代理策略}}}

# Apple Relay
DOMAIN-SUFFIX,apple-relay.apple.com,{{{代理策略}}}
DOMAIN-SUFFIX,apple-relay.cloudflare.com,{{{代理策略}}}
DOMAIN-SUFFIX,apple-relay.fastly-edge.com,{{{代理策略}}}
DOMAIN-SUFFIX,apple-relay.mask.apple-dns.net,{{{代理策略}}}

# Cloudflare Relay
DOMAIN-SUFFIX,cp4.cloudflare.com,{{{代理策略}}}

# iCloud Gateway
DOMAIN-SUFFIX,gateway.icloud.com,{{{代理策略}}}

# Location Services
DOMAIN-SUFFIX,gspel-ssl.ls.apple.com,{{{代理策略}}}
DOMAIN-SUFFIX,ls.apple.com,{{{代理策略}}}

# Smoot (Siri Suggestions)
DOMAIN-SUFFIX,smoot.apple.com,{{{代理策略}}}

# App Store Static Resources
DOMAIN-SUFFIX,apps.mzstatic.com,{{{代理策略}}}
